@model conectabairro.Models.Posts
@using conectabairro.Models
@using conectabairro.Services

@{
    ViewData["Title"] = "Detalhes do Post";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Conecta Bairro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <style>

        .sidebar-right {
            max-height: 100vh;
            overflow-y: auto;
            position: sticky;
            top: 0;
            padding-top: 105px; 
        }

        #secaoPost {
            margin-top: 105px; 
        }

        .card-img-top-custom {
            width: 100%;
            max-height: 400px;
            height: auto;
            display: block;
            object-fit: cover;
        }

        .avatar-lg {
            width: 80px;
            height: 80px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #ccc;
            font-weight: bold;
            font-size: 32px; 
            border-radius: 50%;
        }

        .profile-pic-placeholder {
            width: 40px;
            height: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #ccc; 
            font-weight: bold;
            border-radius: 50%;
            margin-right: 10px;
        }

    </style>
</head>
<body>

    <main class="container-fluid py-4">
        <div class="row">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4" id="secaoPost">
                    <div class="card-body" >

                        <div class="d-flex justify-content-between align-items-start">
                            <small class="text-muted">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar-event me-1" viewBox="0 0 16 16">
                                    <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z" />
                                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                                </svg>

                                @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                            </small>
                            <a type="button" class="btn-close" aria-label="Fechar" method="get" asp-controller="Home" asp-action="Index"></a>
                        </div>

                        <h2 class="card-title mt-3 mb-4">@Model.Titulo</h2>
                        <p class="card-text"><b>Categoria:</b> @FormatarCategoria(Model.Categoria)</p>

                        <div class="mb-3">
                            @if (Model.Status == StatusPost.Pendente)
                            {
                                <p><b>Status:</b><span class="p-1 mb-2 bg-warning text-dark">Pendente</span> </p>
                            }
                            else if (Model.Status == StatusPost.EmAandamento)
                            {
                                <p><b>Status:</b><span class="p-1 mb-2 bg-info text-white">Em andamento</span> </p>
                            }
                            else if (Model.Status == StatusPost.Resolvido)
                            {
                                <p><b>Status:</b><span class="p-1 mb-2 bg-success text-white">Resolvido</span> </p>
                            }
                        </div>

                        <p class="card-text"><b>Descrição:</b> @Model.Descricao</p>


                        <p><b>Imagem:</b></p>
                        <div class="bg-light p-5 border rounded mb-3" style="min-height: 250px;">
                            @if (!string.IsNullOrEmpty(Model.CaminhoImagem))
                            {
                                <img src="@Model.CaminhoImagem"
                                     class="card-img-top-custom"
                                     alt="Anexo do Post: @Model.Titulo"
                                     style="object-position: top;">
                            }
                            else
                            {
                                <div class="card-img-top-custom bg-light d-flex justify-content-center align-items-center text-muted">
                                    Sem imagem
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-right">

                    <div class="card shadow-sm mb-3">
                        <div class="card-body text-center">
                            <div class="avatar-lg mx-auto mb-3">@Model.Usuario.Nome.ToUserInitials()</div>
                            <h5 class="card-title mb-1">@Model.Usuario.Nome</h5>
                            <p class="card-text text-muted mb-3">
                                <small>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill me-1" viewBox="0 0 16 16">
                                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
                                    </svg>
                                    "@Model.Usuario.Rua @Model.Usuario.Bairro @Model.Usuario.Cidade @Model.Usuario.Estado"
                                </small>
                            </p>
                            <button class="btn btn-outline-primary btn-sm mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-fill me-1" viewBox="0 0 16 16">
                                    <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555zM0 4.697v7.403a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4.697l-7.083 3.978L0 4.697z" />
                                </svg>
                                Enviar mensagem
                            </button>

                            <hr />

                            <div class="d-flex justify-content-center">
                                <div class="me-3 text-center">
                                    <form asp-controller="Home" asp-action="GravarLike" method="post" style="display:inline;">
                                        <input type="hidden" name="postId" value="@Model.PostId" />
                                        <input type="hidden" name="tipoReacao" value="@TipoReacao.Like" />
                                        <button type="submit" class="btn btn-link p-0">
                                            @Model.Reacoes.Where(x=> x.TipoReacao == TipoReacao.Like).Count()
                                            <i class="bi bi-hand-thumbs-up-fill"></i>
                                        </button>
                                    </form>
                                </div>
                                <div class="mx-3 text-center">
                                    <form asp-controller="Home" asp-action="GravarLike" method="post" style="display:inline;">
                                        <input type="hidden" name="postId" value="@Model.PostId" />
                                        <input type="hidden" name="tipoReacao" value="@TipoReacao.Dislike" />
                                        <button type="submit" class="btn btn-link p-0">
                                            @Model.Reacoes.Where(x => x.TipoReacao == TipoReacao.Dislike).Count()
                                            <i class="bi bi-hand-thumbs-down-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-center mt-3">
                                <div class="col-md-3">
                                    <a asp-controller="Home" asp-action="EditarPost" asp-route-id="@Model.PostId"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-pencil-fill"></i> Editar
                                    </a>
                                </div>
                                @if (User.Identity.IsAuthenticated &&
                                (Model.UsuarioLogado.TipoUsuarios == TipoUsuario.Admin || Model.Usuario.UsuarioId == Model.UsuarioLogado.UsuarioId))
                                {
                                    <div class="col-md-3">
                                        <a asp-controller="Home" asp-action="DeletarPost" asp-route-id="@Model.PostId"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Tem certeza que deseja apagar esta publicação?');">
                                            <i class="bi bi-trash-fill"></i> Apagar
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Seção de Comentários *@
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title mb-3">Comentários</h6>

                            @if (Model.Comentarios != null)
                            {
                                @* Lista de Comentários *@
                                <div class="mb-4">
                                    @foreach (var comentario in Model.Comentarios)
                                    {
                                        <div class="d-flex align-items-start mb-3">
                                            <div class="profile-pic-placeholder flex-shrink-0">
                                                @comentario.Autor.Nome.ToUserInitials()</div>
                                            <div class="ms-3 w-100">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <small class="fw-bold mb-0">@comentario.Autor.Nome</small>
                                                    @if (comentario.AutorUsuarioId == Model.UsuarioLogado.UsuarioId ||
                                                        Model.UsuarioLogado.TipoUsuarios == TipoUsuario.Admin)
                                                    {
                                                        <form asp-controller="Home" asp-action="DeletarComentario" asp-route-id="@comentario.ComentarioId"
                                                              method="post" onsubmit="return confirm('Tem certeza que deseja excluir este comentário?');">
                                                            <button type="submit" class="btn btn-link p-0">
                                                                <i class="bi bi-trash-fill"></i>
                                                            </button>
                                                        </form>
                                                    }                                                    
                                                </div>
                                                <p class="text-break mb-0 small">@comentario.Conteudo</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <form asp-controller="Home" asp-action="CriarComentario" method="post">
                                <div class="d-flex align-items-center">
                                    <input asp-for="Comentario.Conteudo" type="text" class="form-control me-2" placeholder="Digite seu comentário aqui" aria-label="Digite seu comentário aqui" />

                                    <input type="hidden" asp-for="Comentario.PostId" value="@Model.PostId" />
                                    <input type="hidden" asp-for="Comentario.AutorUsuarioId" value="@Model.UsuarioLogado.UsuarioId" />

                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-send-fill"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    @* Scripts do Bootstrap (Opcional, mas recomendado para funcionalidades como dropdowns, etc.) *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>

@functions {


    private string FormatarCategoria(Categoria categoria)
    {
        return categoria switch
        {
            Categoria.ComercioEServicos => "Comércio e Serviços",
            Categoria.Saude => "Saúde",
            Categoria.EsporteELazer => "Esporte e Lazer",
            Categoria.Zeladoria => "Zeladoria",
            Categoria.Alertas => "Alertas",
            _ => categoria.ToString()
        };
    }
}
@{
    await Html.RenderPartialAsync("ChatPost", Model);
}