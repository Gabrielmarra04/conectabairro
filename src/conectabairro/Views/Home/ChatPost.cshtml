@* @page "{id:int}"
@model SeuProjeto.Pages.Home
@{
    ViewData["Title"] = "Detalhes do Post";
}

<style>
    /* Estilos básicos para corresponder à imagem */
    .modal-dialog-scrollable { /* Simula um modal com scroll se a tela for muito grande */
        max-height: 90vh; /* Ajuste conforme necessário */
        overflow-y: auto;
    }

    .modal-content {
        border-radius: 0.5rem;
    }

    .profile-pic-placeholder {
        width: 40px;
        height: 40px;
        background-color: #ccc; /* Cor de fundo para o placeholder */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: bold;
        flex-shrink: 0; /* Impede que a imagem encolha */
    }

    .comment-card {
        background-color: #f8f9fa; /* Cor de fundo para os cards de comentário */
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 0.75rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
    }

    .comment-input-area {
        background-color: #e9ecef; /* Cor de fundo para a área de input */
        padding: 1rem;
        border-radius: 0.5rem;
    }
</style>

<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content">
        <div class="modal-header d-flex align-items-center justify-content-between pb-0 border-bottom-0">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.Post?.ImagemUrl))
                {
                    <img src="@Model.Post.ImagemUrl" alt="Imagem do Post" class="img-fluid me-3" style="width: 80px; height: 80px; object-fit: cover; border-radius: 0.25rem;" />
                }
                else
                {
                    <div style="width: 80px; height: 80px; background-color: #e9ecef; display: flex; align-items: center; justify-content: center; border-radius: 0.25rem;" class="me-3">
                        <span class="text-muted">No Image</span>
                    </div>
                }
                <div>
                    <h5 class="modal-title mb-0">@Model.Post?.Titulo</h5>
                    <p class="text-muted mb-0">R$@Model.Post?.Preco.ToString("N2")</p>
                </div>
            </div>
            <button type="button" class="btn-close" aria-label="Close" onclick="history.back()"></button>
        </div>

        <div class="modal-body pt-0">
            @if (Model.Post?.Comentarios != null && Model.Post.Comentarios.Any())
            {
                <h6 class="mt-3 mb-2">Comentários</h6>
                <div class="comments-section">
                    @foreach (var comentario in Model.Post.Comentarios.OrderBy(c => c.Id)) // Ordenar por ID para manter a ordem de envio
                    {
                        <div class="comment-card d-flex align-items-start">
                            <div class="profile-pic-placeholder me-3">
                                @(comentario.Autor?.Nome?.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div class="flex-grow-1">
                                <p class="fw-bold mb-0">@comentario.Autor?.Nome</p>
                                <p class="mb-0 small text-muted">@comentario.Conteudo</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-center mt-4 text-muted">Nenhum comentário ainda. Seja o primeiro!</p>
            }
        </div>

        <div class="modal-footer comment-input-area border-top-0">
            <form method="post" class="d-flex w-100">
                <input type="hidden" asp-for="ComentarioInput.PostId" value="@Model.Post?.Id" />
                <input type="text" asp-for="ComentarioInput.Conteudo" class="form-control rounded-pill me-2" placeholder="Digite sua mensagem aqui" required />
                <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.2/font/bootstrap-icons.css">
} *@