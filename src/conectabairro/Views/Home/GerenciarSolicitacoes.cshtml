@model List<conectabairro.Models.SolicitacaoEdicao>

@{
        ViewData["Title"] = "Gerenciar Solicitações";
}
<div class="container mt-5">
    <h2>Gerenciar Solicitações</h2>
    <hr />

    @if (Model.Count == 0)
    {
        <div class="alert alert-success">
            Nenhuma solicitação pendente no momento.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Usuário</th>
                    <th>Nova Rua</th>
                    <th>Novo Bairro</th>
                    <th>Cidade/UF</th>
                    <th>Data</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Usuario?.Nome</td>
                        <td>@item.NovaRua</td>
                        <td>@item.NovoBairro</td>
                        <td>@item.NovaCidade - @item.NovoEstado</td>
                        <td>@item.DataSolicitacao.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="AprovarSolicitacao" asp-controller="Home" method="post">
                                    <input type="hidden" name="id" value="@item.SolicitacaoId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Aprovar
                                    </button>
                                </form>

                                <form asp-action="RejeitarSolicitacao" asp-controller="Home" method="post">
                                    <input type="hidden" name="id" value="@item.SolicitacaoId" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Rejeitar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>