@model conectabairro.Models.Posts
@using conectabairro.Models 

@{
    ViewData["Title"] = "Editar Post";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">Editar Publicação</h1>

            <form asp-action="EditarPost" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="AutorId" value="@Model.AutorId" />
                <input type="hidden" asp-for="PostId" value="@Model.PostId" />
                <input type="hidden" asp-for="LikesCount" value="@Model.LikesCount" />
                <input type="hidden" asp-for="DislikesCount" value="@Model.DislikesCount" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Titulo" class="control-label"></label>
                    <input asp-for="Titulo" class="form-control" value="@Model.Titulo" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descricao" class="control-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Categoria" class="control-label"></label>
                    <select asp-for="Categoria" asp-items="Html.GetEnumSelectList<Categoria>()" class="form-control">
                        <option value="">-- Selecione uma Categoria --</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Status" class="control-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusPost>()" class="form-control">
                        <option value="">-- Selecione um Status --</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <p>Imagem</p>
                    <div class="bg-light p-5 border rounded mb-3" style="min-height: 250px;">
                        @if (!string.IsNullOrEmpty(Model.CaminhoImagem))
                        {
                            <img src="@Model.CaminhoImagem"
                                 class="card-img-top-custom"
                                 alt="Anexo do Post: @Model.Titulo"
                                 style="object-position: top; width: 100%;">
                        }
                        else
                        {
                            <div class="card-img-top-custom bg-light d-flex justify-content-center align-items-center text-muted">
                                Sem imagem
                            </div>
                        }
                    </div>
                    <label asp-for="ImagemArquivo" class="control-label"></label>
                    <input asp-for="ImagemArquivo" type="file" class="form-control" value="@Model.CaminhoImagem" />
                    <span asp-validation-for="ImagemArquivo" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send-fill"></i> Editar
                    </button>
                    <a asp-action="DetalharPost" asp-route-id="@Model.PostId" class="btn btn-outline-secondary">Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}