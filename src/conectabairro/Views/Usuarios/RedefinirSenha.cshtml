@{
    ViewData["Title"] = "Redefinir Senha";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f0f2f5;
        }

        .forgot-container {
            border: 1px solid #ccc;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            padding: 100px;
            background-color: #fff;
        }


        .form-control {
            background-color: #f5f5f5;
            border: 1px solid #ddd;
        }

        #redefinir {
            background-color: #00CBBB;
            border-color: #00CBBB;
            color: white;
            font-weight: bold;
        }

        .small-text {
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>
<body>

    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="forgot-container text-center">
            <div class="logo mb-3">
                <svg width="234" height="73" viewBox="0 0 234 73" xmlns="http://www.w3.org/2000/svg">
                    <rect width="234" height="73" fill="url(#pattern0_388_246)" />
                    <defs>
                        <pattern id="pattern0_388_246" patternContentUnits="objectBoundingBox" width="1" height="1">
                            <use xlink:href="#image0_388_246" transform="matrix(0.00143885 0 0 0.0046122 0 -0.00272987)" />
                        </pattern>
                        <image id="image0_388_246" width="695" height="218" preserveAspectRatio="none" xlink:href="data:image/png;base64," />

                    </defs>
                </svg>
            </div>

            <h2>Redefinir Senha</h2>
            <p class="small-text mb-4">Crie uma nova senha para acessar o sistema. </p>
            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success text-center mt-4">
                    @TempData["Sucesso"]
                </div>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Login", "Usuarios")" class="btn btn-info">Voltar ao Login</a>
                </div>
            }
            else if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger text-center mt-4">
                    @TempData["Erro"]
                </div>
            }
            else
            {
                <!-- Formulário de redefinição -->
                <form method="post" class="mt-4">
                    <div class="mb-3 text-start">
                        <label for="novaSenha">Nova Senha</label>
                        <input type="password" id="novaSenha" name="novaSenha" class="form-control" required />
                    </div>

                    <input type="hidden" name="token" value="@Context.Request.Query["token"]" />

                    <button type="submit" class="btn btn-success mt-3 w-100">Redefinir Senha</button>
                </form>
            }
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
