@model conectabairro.Models.Usuario

@{
    ViewData["Title"] = "Meus Dados";
}

<h2 class="mb-4 mt-5 pt-3">Meus Dados</h2>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <strong>@TempData["MensagemSucesso"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@* --------------------------------------------- *@
<h4>Confira seus dados e edite quando quiser!</h4>

<div class="details-container">
    <div class="row">
        @* Coluna da Esquerda *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Nome</label>
            <div class="data-display-box">@Model.Nome</div>
        </div>

        @* Coluna da Direita *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Email</label>
            <div class="data-display-box">@Model.Email</div>
        </div>
    </div>

    <div class="row">
        @* Coluna da Esquerda *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Telefone</label>
            <div class="data-display-box">
                @(string.IsNullOrEmpty(Model.Telefone) ? "Não informado" : Model.Telefone)
            </div>
        </div>

        @* Coluna da Direita *@
        <div class="col-md-6 mb-3">
        </div>
    </div>

    <div class="row">
        @* Coluna da Esquerda *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Rua</label>
            <div class="data-display-box">
                @(string.IsNullOrEmpty(Model.Rua) ? "Não informado" : Model.Rua)
            </div>
        </div>

        @* Coluna da Direita *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Bairro</label>
            <div class="data-display-box">
                @(string.IsNullOrEmpty(Model.Bairro) ? "Não informado" : Model.Bairro)
            </div>
        </div>
    </div>

    <div class="row">
        @* Coluna da Esquerda *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Cidade</label>
            <div class="data-display-box">
                @(string.IsNullOrEmpty(Model.Cidade) ? "Não informado" : Model.Cidade)
            </div>
        </div>

        @* Coluna da Direita *@
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Estado</label>
            <div class="data-display-box">
                @(string.IsNullOrEmpty(Model.Estado) ? "Não informado" : Model.Estado)
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Tipo de Usuário</label>
            <div class="data-display-box">@Model.TipoUsuarios</div>
        </div>
    </div>

    @* Se for um tipo de usuário que tenha CNPJ, exibe os campos *@
    @if (!string.IsNullOrEmpty(Model.Cnpj))
    {
        <hr class="my-4" />
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">CNPJ</label>
                <div class="data-display-box">@Model.Cnpj</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Razão Social</label>
                <div class="data-display-box">@Model.RazaoSocial</div>
            </div>
        </div>
    }

    <hr class="my-4" />

    <div class="d-flex justify-content-end">
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary me-2">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model.UsuarioId" class="btn btn-primary">Editar Meus Dados</a>
    </div>
</div>