@model conectabairro.Models.Usuario

@{
    ViewData["Title"] = "Editar";
}
<style >
    .fake-modal {
        border: 3px solid #00CBBB; 
        
        background-color: transparent; 

        width: 1300px;
        height: 530px;

        margin: 50px auto;
        padding: 20px;

        border-radius: 15px;
    }
</style>

<h1>Editar - Usuário @Model.Nome</h1>

<div class="fake-modal">
<div class="container">
    <form asp-action="Edit" asp-controller="Usuarios">
        <div class="row">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="PasswordHash" />

                <div class="col-md-6 form-group mb-3">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="Telefone" class="control-label"></label>
                <input asp-for="Telefone" class="form-control" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label for="NovaSenha" class="control-label">Nova Senha</label>
                <input type="password" id="NovaSenha" name="NovaSenha" class="form-control" placeholder="Deixe em branco para manter a senha atual" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="Rua" class="control-label"></label>
                <input asp-for="Rua" class="form-control" />
                <span asp-validation-for="Rua" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="Bairro" class="control-label"></label>
                <input asp-for="Bairro" class="form-control" />
                <span asp-validation-for="Bairro" class="text-danger"></span>
            </div>

        </div>
        <div class="row">

                <div class="col-md-6 form-group mb-3">
                <label asp-for="Cidade" class="control-label"></label>
                <input asp-for="Cidade" class="form-control" />
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="Estado" class="control-label"></label>
                <input asp-for="Estado" class="form-control" />
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
                <div class="col-md-6 form-group mb-3">
                <label asp-for="TipoUsuarios" class="control-label">Tipo Usuário</label>
                <select asp-for="TipoUsuarios" id="tipoUsuario" class="form-control" asp-items="Html.GetEnumSelectList<TipoUsuario>()" disabled></select>
                <span asp-validation-for="TipoUsuarios" class="text-danger"></span>
                <input type="hidden" asp-for="TipoUsuarios" />
            </div>

                <div id="camposOng" class="row col-md-6 mb-3" style="display: none;">
                <div class="col-md-6 form-group">
                    <label asp-for="Cnpj" class="control-label"></label>
                    <input asp-for="Cnpj" class="form-control" />
                    <span asp-validation-for="Cnpj" class="text-danger"></span>
                </div>
                    <div class="col-md-6 form-group mb-3">
                    <label asp-for="RazaoSocial" class="control-label">Razão Social</label>
                    <input asp-for="RazaoSocial" class="form-control" />
                    <span asp-validation-for="RazaoSocial" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr />

        <div class="form-group" style="display: flex; justify-content: flex-end; align-items: center;">

            <a asp-action="Index" class="btn btn-secondary" style="margin-right: 15px;">Voltar</a>

            <a asp-action="Delete" asp-route-id="@Model.UsuarioId" class="btn btn-outline-danger">Excluir usuário</a>

            <input type="submit" value="Salvar Alterações" class="btn btn-primary" style="margin-left: 15px;" />
        </div>
    </form>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @{
        if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <strong>@TempData["MensagemSucesso"]</strong>
            </div>
        }
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectTipoUsuario = document.getElementById('tipoUsuario');
            const camposOng = document.getElementById('camposOng');

            const valorOng = '2';

            function toggleCamposOng() {
                if (selectTipoUsuario) {
                    if (selectTipoUsuario.value === valorOng) {
                        camposOng.style.display = 'flex';
                    } else {
                        camposOng.style.display = 'none';
                    }
                }
            }

            toggleCamposOng();

            if (selectTipoUsuario) {
                selectTipoUsuario.addEventListener('change', toggleCamposOng);
            }
        });
    </script>
}