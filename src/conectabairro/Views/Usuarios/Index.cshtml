@model IEnumerable<conectabairro.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}
@if (TempData["MensagemSucesso"] != null)
{
    <div id="alertaSucesso" class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["MensagemSucesso"]</strong>
    </div>
}
@if (TempData["MensagemDelete"] != null)
{
    <div id="alertaSucesso" class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <strong>@TempData["MensagemDelete"]</strong>
    </div>
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link active" id="usuarios-tab" asp-controller="Usuarios" asp-action="Index">
                        <h4 class="mb-0">Usuários cadastrados</h4>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="solicitacoes-tab" asp-controller="Usuarios" asp-action="Solicitacoes">
                        <h4 class="mb-0">Solicitações</h4>
                    </a>
                </li>
            </ul>

            <form asp-controller="Usuarios" asp-action="Index" method="get">
                <div class="row justify-content-end mb-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Pesquisar" name="SearchString" value="@ViewData["CurrentFilter"]">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary search-btn" type="submit">
                                    <span class="fas fa-search">🔍</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="usuarios-cadastrados" role="tabpanel" aria-labelledby="usuarios-tab">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 30%;">
                                    @Html.DisplayNameFor(model => model.Nome)
                                </th>
                                <th style="width: 30%;">
                                    @Html.DisplayNameFor(model => model.Email)
                                </th>
                                <th style="width: 22%;">
                                    @Html.DisplayNameFor(model => model.Bairro)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Nome)
                                        </td>
                                        <td>
                                            <a href="mailto:@item.Email">@Html.DisplayFor(modelItem => item.Email)</a>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Bairro)
                                        </td>
                                        <td>
                                            <a asp-action="Edit" class="btn btn-sm btn-primary" asp-route-id="@item.UsuarioId" data-action="edit-user">Editar</a> |
                                            @* <a asp-action="Details" class="btn btn-sm btn-secondary" asp-route-id="@item.UsuarioId">Detalhes</a> | *@
                                            <a asp-action="Delete" class="btn btn-sm btn-danger" asp-route-id="@item.UsuarioId">Excluir</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Nenhum usuário encontrado com o filtro aplicado.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="tab-pane fade" id="solicitacoes" role="tabpanel" aria-labelledby="solicitacoes-tab">
                    <p class="py-5 text-center text-muted">Ainda não há solicitações pendentes.</p>
                </div>

                <div class="modal fade" id="editUserModal" tabindex="-1" role="dialog" aria-labelledby="editUserModalLabel" aria-hidden="true">
                    <div id="modalContent">
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>
    setTimeout(function() {
        var alertElement = document.getElementById('alertaSucesso');

        if (alertElement) {
            alertElement.classList.remove('show');

            setTimeout(function() {
                alertElement.remove();
            }, 500);
        }
    }, 5000);
</script>

<
<style>
    
    .dark-mode .table-light {
        background-color: #1e1e1e !important;
        color: #ffffff !important;
    }

   
    .dark-mode table tbody tr td,
    .dark-mode table thead th {
        color: #ffffff !important;
    }

    
    .search-btn {
        background-color: #f8f9fa;
        border: 1px solid #ced4da;
    }

    .dark-mode .search-btn {
        background-color: #2a2a2a !important;
        color: #ffffff !important;
        border-color: #444 !important;
    }

    
    .dark-mode input::placeholder {
        color: #cccccc !important;
    }
</style>
